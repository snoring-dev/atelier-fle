# LLM (OpenRouter)
OPENROUTER_API_KEY=
MODEL_ID=google/gemini-3.5-flash-lite

# Illustrations (OpenRouter Image API — same OPENROUTER_API_KEY)
IMAGE_MODEL_ID=google/gemini-3.1-flash-image

# Database (SQLite strategy)
DATABASE_PROVIDER=sqlite
# Local (`pnpm dev`): file:./data/fle.db
# Compose overrides DATABASE_URL to file:/app/data/fle.db
DATABASE_URL=file:./data/fle.db

# Gotenberg (PDF)
# Compose overrides these to http://pdf:3000 and http://web:3000
GOTENBERG_URL=http://localhost:3001
PUBLIC_INTERNAL_URL=http://localhost:3000

# Auth (US-1.2)
# Generate hash (base64, safe for dotenv): echo -n 'your-password' | pnpm auth:hash
AUTH_PASSWORD_HASH=
# Long random secret (e.g. openssl rand -hex 32)
AUTH_SECRET=
