# LLM
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-4-20250514

# Illustrations
IMAGE_API_KEY=
IMAGE_MODEL_ID=

# Database (SQLite strategy)
DATABASE_PROVIDER=sqlite
# Local (`pnpm dev`): file:./data/fle.db
# Compose overrides DATABASE_URL to file:/app/data/fle.db
DATABASE_URL=file:./data/fle.db

# Gotenberg (PDF)
# Compose overrides these to http://pdf:3000 and http://web:3000
GOTENBERG_URL=http://localhost:3001
PUBLIC_INTERNAL_URL=http://localhost:3000

# Auth (US-1.2)
# Generate hash with argon2; secret should be long and random.
AUTH_PASSWORD_HASH=
AUTH_SECRET=
